# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Azure original site credentials (server-side scrape via lib/getScores.ts)
ORIGINAL_SITE_EMAIL=your-family-login-email
ORIGINAL_SITE_PASSWORD=your-family-login-password
