# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (Settings → API → service_role) — server-only, for avatar uploads
# Add this in Vercel env vars; do NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NOTE: ORIGINAL_SITE_EMAIL / ORIGINAL_SITE_PASSWORD are no longer needed.
# Scores are now pulled directly from the public Google Sheets xlsx export
# (see XLSX_URL in lib/getScores.ts) — no login/scrape credentials required.
